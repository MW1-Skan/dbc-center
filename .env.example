# Resend API key used by lib/email/resend.ts to send form notifications.
RESEND_API_KEY=

# Inbox that receives booking requests, call-back requests and room inquiries.
CLINIC_EMAIL=

# Verified sender for Resend. Defaults to onboarding@resend.dev (works only for test sends).
NOTIFY_FROM_EMAIL=

# Canonical site origin used for metadata, sitemap and robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
